# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored; this file is committed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# When running via docker-compose, the host is the service name (`postgres`), not localhost.
DATABASE_URL="postgresql://attendance:attendance@localhost:5432/attendance?schema=public"

# Both must be at least 32 characters, and must differ from each other.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-me-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-me-with-a-different-32-plus-character-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Brute-force protection on /auth/login (per IP).
THROTTLE_AUTH_LIMIT=5
THROTTLE_AUTH_TTL_SECONDS=60
THROTTLE_GLOBAL_LIMIT=120
THROTTLE_GLOBAL_TTL_SECONDS=60

# Analytics. Minutes past local midnight; 555 = 09:15.
LATE_ARRIVAL_CUTOFF_MINUTES=555
# IANA zone the day boundary and late cut-off are evaluated in.
REPORTING_TIMEZONE=UTC

# Device tuning served by GET /api/v1/config.
FACE_MATCH_THRESHOLD=0.75
MAX_LOCATION_ACCURACY_METERS=30
EMBEDDING_MODEL_VERSION=mobilefacenet-v1
MAX_SYNC_BATCH_SIZE=200

# Comma-separated origins, or * to allow any.
CORS_ORIGINS=*

# Used by prisma/seed.ts only.
SEED_PASSWORD=ChangeMe123!
