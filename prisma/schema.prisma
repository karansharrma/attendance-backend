// Mirrors the mobile app's Room database. Field names and semantics are deliberately
// identical on both sides so the sync payload needs no translation layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AttendanceStatus {
  VERIFIED
  FLAGGED_OUTSIDE_GEOFENCE
  UNRESTRICTED
}

enum PunchType {
  IN
  OUT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  EMPLOYEE
  ADMIN
}

model Employee {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String

  /// True when this employee may punch in from anywhere, regardless of site assignments.
  isUnrestricted Boolean @default(false)

  /// Raw little-endian float32 vector, byte-identical to the BLOB the device caches in Room.
  /// Never serialised into any response except the owning employee's own sync payload.
  faceEmbedding Bytes?

  /// Which model produced faceEmbedding. Embeddings from different models are not
  /// comparable, so the device refuses to match across a version change.
  embeddingModelVersion String?

  role Role @default(EMPLOYEE)

  /// Per-admin preference. Punch-ins are always delivered; an admin may opt out of punch-outs.
  punchOutNotificationsEnabled Boolean @default(true)

  sites             EmployeeSite[]
  attendanceRecords AttendanceRecord[]
  pushTokens        PushToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

/// FCM registration tokens for the Android/iOS app and for web push. A user can use several
/// devices; Firebase tokens rotate, so registering the same token updates its owner/platform.
model PushToken {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@map("push_tokens")
}

model Site {
  id           String @id @default(uuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Float

  employees EmployeeSite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sites")
}

model EmployeeSite {
  employeeId String
  siteId     String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([employeeId, siteId])
  @@index([siteId])
  @@map("employee_sites")
}

model AttendanceRecord {
  /// Client-generated UUID. This is what makes /attendance/sync idempotent: the mobile sync
  /// worker retries on network failure and must not create duplicates on partial success.
  id String @id

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  timestamp DateTime
  latitude  Float
  longitude Float

  matchedSiteId       String?
  faceMatchConfidence Float

  status         AttendanceStatus
  isMockLocation Boolean

  /// Whether this is a punch-in or punch-out event
  punchType PunchType @default(IN)

  /// Reference to the paired punch record (null for unpaired records)
  pairedPunchId String?

  /// Calculated shift duration in minutes (only set for punch-out records)
  shiftDurationMinutes Int?

  reviewedByAdminId String?
  reviewedAt        DateTime?
  reviewNote        String?
  reviewStatus      ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The admin dashboard filters almost exclusively on these three.
  @@index([employeeId])
  @@index([timestamp])
  @@index([status])
  @@index([reviewStatus])
  @@index([employeeId, timestamp])
  @@index([punchType])
  @@index([pairedPunchId])
  @@map("attendance_records")
}
